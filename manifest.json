{
  "manifest_version": 3,
  "name": "easywire",
  "version": "0.2.1",
  "description": "Campuswire feed: latest-activity times, reply counts, activity sort, and personal pins.",
  "permissions": ["storage", "unlimitedStorage"],
  "icons": { "16": "src/icons/icon-16.png", "32": "src/icons/icon-32.png", "48": "src/icons/icon-48.png", "128": "src/icons/icon-128.png" },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "easywire",
    "default_icon": { "16": "src/icons/icon-16.png", "32": "src/icons/icon-32.png", "48": "src/icons/icon-48.png", "128": "src/icons/icon-128.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://campuswire.com/*"],
      "js": ["src/guard.js", "src/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://campuswire.com/*"],
      "js": ["src/activity.js", "src/pins.js", "src/fetcher.js", "src/render.js", "src/export.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
